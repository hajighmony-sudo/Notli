<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vocal_studio_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/vocal_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:maxLines="2" />

        <TextView
            android:id="@+id/vocal_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:maxLines="2" />

        <TextView
            android:id="@+id/vocal_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vocal_privacy_notice"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vocal_download_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vocal_download_model" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vocal_process_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vocal_make_instrumental"
            android:enabled="false" />

        <ProgressBar
            android:id="@+id/vocal_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:max="100" />

        <TextView
            android:id="@+id/vocal_progress_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vocal_cancel_button"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vocal_cancel"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vocal_preview_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vocal_preview"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vocal_save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vocal_save"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vocal_discard_button"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vocal_discard"
            android:enabled="false" />
    </LinearLayout>
</ScrollView>
