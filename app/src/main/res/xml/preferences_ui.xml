<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/set_ui">

    <PreferenceCategory app:title="@string/set_display">
        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="@integer/theme_auto"
            app:entries="@array/entries_theme"
            app:entryIcons="@array/icons_theme"
            app:entryValues="@array/values_theme"
            app:icon="@drawable/ic_light_24"
            app:key="@string/set_key_theme"
            app:title="@string/set_theme" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_round_mode"
            app:summary="@string/set_round_mode_desc"
            app:title="@string/set_round_mode" />
    </PreferenceCategory>

    <PreferenceCategory app:title="NOTLI AURORA">
        <Preference
            app:selectable="false"
            app:title="@string/aurora_identity"
            app:summary="@string/aurora_identity_desc" />

        <PreferenceCategory app:title="@string/aurora_colors">
            <Preference app:key="notli_aurora_primary" app:title="@string/aurora_primary" app:summary="@string/aurora_pick_color" />
            <Preference app:key="notli_aurora_secondary" app:title="@string/aurora_secondary" app:summary="@string/aurora_pick_color" />
            <Preference app:key="notli_aurora_surface" app:title="@string/aurora_surface" app:summary="@string/aurora_pick_color" />
            <Preference app:key="notli_aurora_background" app:title="@string/aurora_background" app:summary="@string/aurora_pick_color" />
            <Preference app:key="aurora_reset_colors" app:title="@string/aurora_reset_colors" />
        </PreferenceCategory>

        <PreferenceCategory app:title="@string/aurora_layout">
            <SeekBarPreference
                app:key="notli_aurora_font_scale"
                app:title="@string/aurora_font_size"
                app:summary="@string/aurora_font_size_desc"
                app:defaultValue="100"
                app:min="80"
                android:max="140"
                app:seekBarIncrement="5"
                app:showSeekBarValue="true" />
            <SeekBarPreference
                app:key="notli_aurora_icon_scale"
                app:title="@string/aurora_icon_size"
                app:summary="@string/aurora_icon_size_desc"
                app:defaultValue="100"
                app:min="75"
                android:max="150"
                app:seekBarIncrement="5"
                app:showSeekBarValue="true" />
            <ListPreference
                app:key="notli_aurora_density"
                app:title="@string/aurora_density"
                app:defaultValue="1"
                app:entries="@array/entries_aurora_density"
                app:entryValues="@array/values_aurora_density"
                app:useSimpleSummaryProvider="true" />
            <Preference app:key="aurora_reset_layout" app:title="@string/aurora_reset_layout" />
        </PreferenceCategory>

        <PreferenceCategory app:title="@string/aurora_motion">
            <ListPreference
                app:key="notli_aurora_motion"
                app:title="@string/aurora_motion_profile"
                app:defaultValue="2"
                app:entries="@array/entries_aurora_motion"
                app:entryValues="@array/values_aurora_motion"
                app:useSimpleSummaryProvider="true" />
            <SeekBarPreference
                app:key="notli_aurora_motion_speed"
                app:title="@string/aurora_motion_speed"
                app:summary="@string/aurora_motion_speed_desc"
                app:defaultValue="100"
                app:min="50"
                android:max="150"
                app:seekBarIncrement="5"
                app:showSeekBarValue="true" />
            <Preference app:key="aurora_reset_motion" app:title="@string/aurora_reset_motion" />
        </PreferenceCategory>

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_black_theme"
            app:summary="@string/set_black_mode_desc"
            app:title="@string/set_black_mode" />
    </PreferenceCategory>
</PreferenceScreen>
